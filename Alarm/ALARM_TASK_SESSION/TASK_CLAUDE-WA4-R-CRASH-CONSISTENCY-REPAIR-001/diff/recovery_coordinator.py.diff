+    @staticmethod
+    def _history_reconcilable(projection: dict[str, Any]) -> bool:
+        return any(item["code"] in ("MICROTASK_HISTORY_PENDING", "OPERATION_INTENT_PENDING")
+                   for item in projection["diagnostics"])
+
+    def _reconcile_history(self, task_id: str) -> dict[str, Any]:
+        """R-MT / R-OP bounded step: close interrupted journal entries from durable facts only.
+
+        Under the operation TASK lock and the mutation lock (every writer of an
+        operation record or a microtask status holds them). No physical mutation
+        and no record/status change: only the commit/abandon/intent events whose
+        content the authoritative records determine. A contradiction is left in
+        place for the projection (blocker -> FAIL_CLOSED, operator).
+        """
+        outcome: dict[str, Any] = {"result": "HISTORY_RECONCILED", "microtasks": [], "operations": [],
+                                   "physical_mutation_performed": False}
+        with self.operations.task_lock(task_id):
+            with self.tasks.mutation_lock(task_id):
+                events = self.operations.events
+                try:
+                    microtask_ids = sorted(events.microtask_statuses(task_id))
+                except EventCheckpointStoreError as exc:
+                    microtask_ids, outcome["microtask_error"] = [], str(exc)
+                for microtask_id in microtask_ids:
+                    try:
+                        outcome["microtasks"].extend(events.resolve_microtask_intents_locked(task_id, microtask_id))
+                    except EventCheckpointStoreError as exc:
+                        outcome.setdefault("left_for_operator", []).append(f"{microtask_id}: {exc}")
+                try:
+                    for record in self.operations.list(task_id):
+                        if self.operations._reconcile_intent_locked(task_id, record):
+                            outcome["operations"].append(record.operation_id)
+                except (OperationStoreError, TaskStoreError) as exc:
+                    outcome.setdefault("left_for_operator", []).append(str(exc))
+        return outcome
