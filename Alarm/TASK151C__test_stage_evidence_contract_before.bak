from __future__ import annotations

import copy
import tempfile
import unittest
from pathlib import Path
from unittest.mock import AsyncMock

from planner_runtime import PlannerError, validate_plan
from task_planner import (
    TaskLifecycle,
    evidence_arguments_fingerprint,
    evidence_dependency_state_fingerprint,
    evidence_dependency_targets,
)


def read_evidence_plan(*, mode="server_evidence"):
    return {
        "stages": [{
            "stage_id": "read_stage",
            "goal": "read exact target",
            "stage_type": "analysis",
            "persistence_required": False,
            "allowed_capabilities": ["READ"],
            "artifacts": [],
            "completion_mode": mode,
            "evidence_requirements": [{
                "evidence_id": "readback",
                "tool": "read_file",
                "arguments": {"path": "result.md"},
            }],
            "completion_criteria": ["target read"],
        }],
        "obligation_changes": [],
    }


def verify_evidence_plan():
    return {
        "stages": [{
            "stage_id": "verify_stage",
            "goal": "verify exact content",
            "stage_type": "verification",
            "persistence_required": False,
            "allowed_capabilities": ["VERIFY"],
            "artifacts": [],
            "completion_mode": "server_evidence",
            "evidence_requirements": [{
                "evidence_id": "equals_check",
                "tool": "verify_file_content",
                "arguments": {
                    "path": "result.md",
                    "kind": "equals",
                    "value": "done\n",
                },
            }],
            "completion_criteria": ["exact deterministic verification passed"],
        }],
        "obligation_changes": [],
    }


class StageEvidenceContractTests(unittest.IsolatedAsyncioTestCase):
    def lifecycle(self, plan, tools, snapshot=None):
        temp = tempfile.TemporaryDirectory()
        self.addCleanup(temp.cleanup)
        events = []
        planner = AsyncMock(return_value=copy.deepcopy(plan))
        snapshot = snapshot or (
            lambda _path: {"exists": False, "sha256": None, "content": ""}
        )
        lifecycle = TaskLifecycle(
            path=Path(temp.name) / "plan.json",
            run_id="run_evidence",
            task_block_id="tb_1234567890abcdef1234567890abcdef",
            raw_task="task",
            planner_call=planner,
            emit=lambda name, payload: events.append({"event": name, **payload}),
            snapshot=snapshot,
            prepare=lambda *_args: {},
            dredd_enabled=False,
        )
        return lifecycle, events, [{"name": name} for name in tools]

    def evidence_fact(self, lifecycle, *, stage_id, tool, arguments, status="OK", executed=True):
        state = lifecycle.state["stage_states"][stage_id]
        observed_state_sha256 = None
        dependency_targets = evidence_dependency_targets(tool, arguments)
        if dependency_targets:
            observed_state_sha256 = evidence_dependency_state_fingerprint(
                lifecycle.snapshot,
                tool,
                arguments,
            )
        requirement_ids = [
            requirement["evidence_id"]
            for requirement in (
                next(
                    stage
                    for stage in lifecycle.plan["stages"]
                    if stage["stage_id"] == stage_id
                ).get("evidence_requirements") or []
            )
            if requirement["tool"] == tool
            and evidence_arguments_fingerprint(requirement["arguments"])
            == evidence_arguments_fingerprint(arguments)
        ]
        return {
            "source_record_id": "rec_test_evidence",
            "task_block_id": lifecycle.state["task_block_id"],
            "run_id": lifecycle.state["run_id"],
            "plan_version": lifecycle.state["plan_version"],
            "stage_id": stage_id,
            "evidence_generation": state.get("evidence_generation", 0),
            "requirement_ids": requirement_ids,
            "target_identity": arguments.get("path"),
            "tool": tool,
            "capability": "VERIFY" if tool == "verify_file_content" else "READ",
            "status": status,
            "executed": executed,
            "arguments_sha256": evidence_arguments_fingerprint(arguments),
            "observed_state_sha256": observed_state_sha256,
        }

    async def test_exact_read_evidence_auto_completes_server_evidence_stage(self):
        lifecycle, events, tools = self.lifecycle(read_evidence_plan(), ["read_file"])
        await lifecycle.initialize({"tools": tools})
        args = {"path": "result.md"}
        decision = lifecycle.after_non_persistence_evidence([
            self.evidence_fact(
                lifecycle,
                stage_id="read_stage",
                tool="read_file",
                arguments=args,
            )
        ])
        self.assertEqual(decision, {"action": "final"})
        self.assertIsNone(lifecycle.stage)
        self.assertIn(
            "non_persistence_evidence_satisfied",
            [event["event"] for event in events],
        )

    async def test_contains_does_not_satisfy_required_equals(self):
        lifecycle, _events, tools = self.lifecycle(
            verify_evidence_plan(), ["verify_file_content"]
        )
        await lifecycle.initialize({"tools": tools})
        wrong = {
            "path": "result.md",
            "kind": "contains",
            "value": "done\n",
        }
        wrong_fact = self.evidence_fact(
            lifecycle,
            stage_id="verify_stage",
            tool="verify_file_content",
            arguments=wrong,
        )
        decision = lifecycle.after_non_persistence_evidence([wrong_fact])
        self.assertIsNone(decision)
        self.assertEqual(lifecycle.stage["stage_id"], "verify_stage")
        self.assertFalse(
            lifecycle.non_persistence_evidence_satisfied([wrong_fact])
        )

    async def test_model_result_stage_does_not_auto_complete_from_evidence(self):
        lifecycle, _events, tools = self.lifecycle(
            read_evidence_plan(mode="model_result"), ["read_file"]
        )
        await lifecycle.initialize({"tools": tools})
        args = {"path": "result.md"}
        decision = lifecycle.after_non_persistence_evidence([
            self.evidence_fact(
                lifecycle,
                stage_id="read_stage",
                tool="read_file",
                arguments=args,
            )
        ])
        self.assertIsNone(decision)
        self.assertEqual(lifecycle.stage["stage_id"], "read_stage")

    def test_verification_stage_cannot_fall_back_to_model_result(self):
        candidate = verify_evidence_plan()
        candidate["stages"][0]["completion_mode"] = "model_result"
        with self.assertRaisesRegex(
            PlannerError, "Verification stage requires server_evidence"
        ):
            validate_plan(candidate)

    async def test_old_plan_version_evidence_does_not_satisfy_reinstalled_stage(self):
        plan = read_evidence_plan()
        lifecycle, _events, tools = self.lifecycle(plan, ["read_file"])
        await lifecycle.initialize({"tools": tools})
        args = {"path": "result.md"}
        old_fact = self.evidence_fact(
            lifecycle,
            stage_id="read_stage",
            tool="read_file",
            arguments=args,
        )
        self.assertEqual(
            lifecycle.after_non_persistence_evidence([old_fact]),
            {"action": "final"},
        )

        lifecycle.install(copy.deepcopy(plan))
        self.assertEqual(lifecycle.state["plan_version"], 2)
        self.assertEqual(lifecycle.stage["stage_id"], "read_stage")
        self.assertFalse(
            lifecycle.non_persistence_evidence_satisfied([old_fact])
        )

    async def test_execution_repair_generation_invalidates_old_evidence(self):
        lifecycle, _events, tools = self.lifecycle(
            read_evidence_plan(), ["read_file"]
        )
        await lifecycle.initialize({"tools": tools})
        args = {"path": "result.md"}
        old_fact = self.evidence_fact(
            lifecycle,
            stage_id="read_stage",
            tool="read_file",
            arguments=args,
        )
        self.assertEqual(
            lifecycle.after_non_persistence_evidence([old_fact]),
            {"action": "final"},
        )
        generation_before = lifecycle.state["stage_states"]["read_stage"][
            "evidence_generation"
        ]

        lifecycle.execution_defect(["read_stage"])
        generation_after = lifecycle.state["stage_states"]["read_stage"][
            "evidence_generation"
        ]
        self.assertEqual(generation_after, generation_before + 1)
        self.assertEqual(lifecycle.stage["stage_id"], "read_stage")
        self.assertFalse(
            lifecycle.non_persistence_evidence_satisfied([old_fact])
        )

    async def test_target_state_drift_invalidates_satisfied_evidence(self):
        observed = {
            "exists": True,
            "sha256": "a" * 64,
            "content": "before",
        }
        lifecycle, events, tools = self.lifecycle(
            read_evidence_plan(),
            ["read_file"],
            snapshot=lambda _path: dict(observed),
        )
        await lifecycle.initialize({"tools": tools})
        args = {"path": "result.md"}
        fact = self.evidence_fact(
            lifecycle,
            stage_id="read_stage",
            tool="read_file",
            arguments=args,
        )
        self.assertEqual(
            lifecycle.after_non_persistence_evidence([fact]),
            {"action": "final"},
        )

        observed["sha256"] = "b" * 64
        observed["content"] = "after"
        stale = lifecycle.invalidate_stale_satisfied_evidence([fact])

        self.assertEqual(stale, ["read_stage"])
        self.assertEqual(lifecycle.stage["stage_id"], "read_stage")
        self.assertEqual(
            lifecycle.state["stage_states"]["read_stage"]["status"],
            "WORKING",
        )
        self.assertIn(
            "evidence_invalidated",
            [event["event"] for event in events],
        )

    async def test_missing_source_record_identity_is_fail_closed(self):
        lifecycle, _events, tools = self.lifecycle(
            read_evidence_plan(), ["read_file"]
        )
        await lifecycle.initialize({"tools": tools})
        args = {"path": "result.md"}
        fact = self.evidence_fact(
            lifecycle,
            stage_id="read_stage",
            tool="read_file",
            arguments=args,
        )
        fact["source_record_id"] = None
        self.assertFalse(
            lifecycle.non_persistence_evidence_satisfied([fact])
        )

    async def test_dependency_drift_in_compile_paths_invalidates_old_evidence(self):
        compile_plan = {
            "stages": [{
                "stage_id": "compile_stage",
                "goal": "compile exact dependencies",
                "stage_type": "verification",
                "persistence_required": False,
                "allowed_capabilities": ["VERIFY"],
                "artifacts": [],
                "completion_mode": "server_evidence",
                "evidence_requirements": [{
                    "evidence_id": "compile_exact",
                    "tool": "python_compile",
                    "arguments": {
                        "paths": ["a.py", "b.py"],
                    },
                }],
                "completion_criteria": ["compile passes"],
            }],
            "obligation_changes": [],
        }
        states = {
            "a.py": {
                "exists": True,
                "sha256": "a" * 64,
                "content": "a",
            },
            "b.py": {
                "exists": True,
                "sha256": "b" * 64,
                "content": "b",
            },
        }
        lifecycle, _events, tools = self.lifecycle(
            compile_plan,
            ["python_compile"],
            snapshot=lambda path: dict(states[path]),
        )
        await lifecycle.initialize({"tools": tools})
        args = {"paths": ["a.py", "b.py"]}
        fact = self.evidence_fact(
            lifecycle,
            stage_id="compile_stage",
            tool="python_compile",
            arguments=args,
        )
        self.assertEqual(
            lifecycle.after_non_persistence_evidence([fact]),
            {"action": "final"},
        )

        states["b.py"]["sha256"] = "c" * 64
        stale = lifecycle.invalidate_stale_satisfied_evidence([fact])
        self.assertEqual(stale, ["compile_stage"])
        self.assertFalse(
            lifecycle.non_persistence_evidence_satisfied([fact])
        )

    async def test_unavailable_evidence_tool_is_rejected_by_initial_validation(self):
        plan = verify_evidence_plan()
        lifecycle, events, _tools = self.lifecycle(plan, [])
        with self.assertRaisesRegex(Exception, "planner_protocol_or_runtime_error"):
            await lifecycle.initialize({"tools": [{"name": "read_file"}]})
        rejected = [
            event for event in events
            if event["event"] == "planner_attempt_rejected"
        ]
        self.assertTrue(rejected)
        self.assertIn("unavailable tool", rejected[0]["error_message"])


if __name__ == "__main__":
    unittest.main()
